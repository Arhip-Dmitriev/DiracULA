# Functions of operators: exp(i t X), exp(i t sum_j Z_j) on n qubits, exp(i t S) for the shift
# S of a qudit of dimension d, and the square root of SWAP.
var t: real
var n, d

show(exp(i*t*X) |0>)
show(exp(i*t*sum(j in 0..n){ I^@j @ Z @ I^@(n - 1 - j) }) H^@n |0>^@n)
gate SH = |x>_d -> |(x + 1) % d>_d
show(exp(i*t*SH) |0>_d)
show(sqrt(SWAP) |0>|1>)
