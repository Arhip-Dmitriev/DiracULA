# The reduced state of an n-qudit GHZ state on its first qudit, for every n >= 2 and d: the
# maximally mixed state I/d. The trace of the Fourier transform is the quadratic Gauss sum.
var n, d
assume n >= 2

|ghz>_d = 1/sqrt(d) sum(k in 0..d){ |k>_d @ |k>_d^@(n-1) }
show(keep(|ghz>, 0))
show(tr(|ghz>, 1))
show(tr(|ghz>))
show(tr(keep(|ghz>, 0)))

gate QFT = |x>_d -> 1/sqrt(d) sum(y in 0..d){ e^(2*pi*i*x*y/d) |y>_d }
show(tr(QFT))
